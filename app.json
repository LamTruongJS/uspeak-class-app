{
  "expo": {
    "name": "Uspeak Academy",
    "slug": "uspeak-class-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "uspeakclass",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "vn.uspeak.classapp",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.uspeak.classapp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Uspeak cần dùng micro để ghi âm bài luyện nói và gửi tin nhắn thoại cho lớp.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Uspeak cần truy cập ảnh để bạn chọn ảnh bài làm nộp cho giáo viên.",
          "cameraPermission": "Uspeak cần dùng camera để bạn chụp ảnh bài làm nộp cho giáo viên."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#b62025",
          "icon": "./assets/images/notification-icon.png",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-asset",
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f4c8cc0-3a33-4c8a-83c3-8f9c7b02873c"
      }
    },
    "owner": "lamtruong"
  }
}
