{
  "expo": {
    "name": "Uspeak Class",
    "slug": "uspeak-class-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uspeakclass",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "vn.uspeak.classapp",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.uspeak.classapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0B0D12"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Uspeak cần dùng micro để ghi âm câu trả lời khi bạn làm bài luyện nói."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Uspeak cần truy cập ảnh để bạn chọn ảnh bài làm nộp cho giáo viên.",
          "cameraPermission": "Uspeak cần dùng camera để bạn chụp ảnh bài làm nộp cho giáo viên."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#b62025"
        }
      ],
      "expo-asset",
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
